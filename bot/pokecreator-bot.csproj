<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>pokecreator_bot</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.19.1" />
    <PackageReference Include="PKHeX.Core" Version="26.5.5" />
  </ItemGroup>

  <!-- The bot is self-contained: it owns PkHexService.cs + PokemonModels.cs and
       embeds PKHeX.Core directly. It does NOT depend on the web API project. -->

</Project>
